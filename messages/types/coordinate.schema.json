{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Coordinate",
  "description": "A WGS 84 geographic position. Height is measured in meters above the WGS 84 ellipsoid.",
  "type": "object",
  "properties": {
    "longitude_degrees": {
      "type": "number",
      "minimum": -180,
      "maximum": 180
    },
    "latitude_degrees": {
      "type": "number",
      "minimum": -90,
      "maximum": 90
    },
    "height_meters": {
      "type": "number"
    }
  },
  "required": [
    "longitude_degrees",
    "latitude_degrees",
    "height_meters"
  ],
  "additionalProperties": false
}
