{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Velocity",
  "description": "A velocity vector in the local scene frame in meters per second: x east, y north, z up.",
  "type": "object",
  "properties": {
    "x_meters_per_second": {
      "type": "number"
    },
    "y_meters_per_second": {
      "type": "number"
    },
    "z_meters_per_second": {
      "type": "number"
    }
  },
  "required": [
    "x_meters_per_second",
    "y_meters_per_second",
    "z_meters_per_second"
  ],
  "additionalProperties": false
}
